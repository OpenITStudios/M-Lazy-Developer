{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mivubi:report-system-next:report:v1.3",
  "title": "M-Lazy Report Next Canonical Report v1.3",
  "description": "Design-only locked format. Not a converter of existing Approved Bug Report V2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "layoutVersion",
    "reportId",
    "scope",
    "maps",
    "reportKind",
    "auditRevision"
  ],
  "properties": {
    "schema": {
      "const": "m-lazy-report-next/v1.3"
    },
    "layoutVersion": {
      "const": "1.3.0"
    },
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "MAP",
        "COMBINED"
      ]
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/map"
      }
    },
    "reportKind": {
      "type": "string",
      "enum": [
        "MAP_AUDIT",
        "SOURCE_REVIEW",
        "SYNTHETIC_DEMO"
      ]
    },
    "auditRevision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapId",
        "name",
        "artifact",
        "evidence",
        "levels",
        "auditCoverage"
      ],
      "properties": {
        "mapId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "auditCoverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/auditCoverage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "fingerprint",
        "version",
        "edition",
        "sourceLabel",
        "sourceUrl"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "edition": {
          "type": "string",
          "enum": [
            "BEDROCK",
            "EDUCATION",
            "UNKNOWN"
          ]
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "AUTHORED_DESIGN",
            "SOURCE_STATIC",
            "PACKAGE_INSPECTION",
            "LIVE_MINECRAFT",
            "TESTER_OBSERVATION",
            "REFERENCE_UNRESOLVED"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "FILE",
                "NBT",
                "FUNCTION",
                "ENTITY",
                "WORLD",
                "SCREENSHOT",
                "OTHER"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sourceOrigin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceScope": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "selected-artifact",
                "external-reference",
                "runtime"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levelId",
        "label",
        "findings"
      ],
      "properties": {
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "finding": {
      "oneOf": [
        {
          "$ref": "#/$defs/issue"
        },
        {
          "$ref": "#/$defs/note"
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "severity",
        "evidenceLevel",
        "title",
        "problem",
        "rationale",
        "impact",
        "expected",
        "observed",
        "evidenceRefs",
        "testProcedure",
        "technical",
        "validation",
        "proofStatus",
        "auditDetails"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "BUG",
            "DESIGN_MISMATCH"
          ]
        },
        "severity": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "BLOCKER",
                "MAJOR",
                "MINOR"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceLevel": {
          "type": "string",
          "enum": [
            "SOURCE_VERIFIED",
            "PACKAGE_VERIFIED",
            "RUNTIME_OBSERVED",
            "REFERENCE_UNRESOLVED"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "impact": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "observed": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testProcedure": {
          "anyOf": [
            {
              "$ref": "#/$defs/testProcedure"
            },
            {
              "type": "null"
            }
          ]
        },
        "technical": {
          "$ref": "#/$defs/technical"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/validation"
            },
            {
              "type": "null"
            }
          ]
        },
        "proofStatus": {
          "type": "string",
          "enum": [
            "PROVEN",
            "NEED_VALIDATION"
          ]
        },
        "auditDetails": {
          "anyOf": [
            {
              "$ref": "#/$defs/auditDetails"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proofStatus": {
                "const": "NEED_VALIDATION"
              }
            },
            "required": [
              "proofStatus"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "type": "null"
              },
              "validation": {
                "$ref": "#/$defs/validation"
              }
            }
          },
          "else": {
            "properties": {
              "severity": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "BLOCKER",
                      "MAJOR",
                      "MINOR"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "validation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "testProcedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "visibleOutcome"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instruction",
              "evidenceRefs"
            ],
            "properties": {
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "maxItems": 5
        },
        "visibleOutcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis",
        "recommendedFix",
        "relatedSources",
        "mustPreserve"
      ],
      "properties": {
        "analysis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "recommendedFix": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedSources": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mustPreserve": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "action",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "DEV_NOTE"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "auditCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary",
        "missingProof",
        "evidenceRefs",
        "checks"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "missingProof": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "missingProof",
        "nextCheck"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missingProof": {
          "type": "string",
          "minLength": 1
        },
        "nextCheck": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reason",
        "missingProof",
        "nextCheck",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missingProof": {
          "type": "string",
          "minLength": 1
        },
        "nextCheck": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "auditDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameplayFlow",
        "failureDomain",
        "reproductionCues",
        "suspectedOutcome",
        "evidenceLimitation",
        "proofCeiling",
        "counterEvidence"
      ],
      "properties": {
        "gameplayFlow": {
          "type": "string",
          "minLength": 1
        },
        "failureDomain": {
          "type": "string",
          "minLength": 1
        },
        "reproductionCues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suspectedOutcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceLimitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "proofCeiling": {
          "type": "string",
          "enum": [
            "PROVEN",
            "NEEDS_DECIDING_PROOF"
          ]
        },
        "counterEvidence": {
          "type": "string",
          "enum": [
            "cleared",
            "unresolved"
          ]
        },
        "scenarioLabel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "affectedScope": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "contributingDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "informationMismatch": {
          "type": "boolean"
        },
        "playerFacingEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowledgeRequirementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validationGroupKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "proofNavigation": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reportKind": {
            "const": "MAP_AUDIT"
          }
        },
        "required": [
          "reportKind"
        ]
      },
      "then": {
        "properties": {
          "auditRevision": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "auditRevision": {
            "type": "null"
          }
        }
      }
    }
  ]
}
