{
  "system": "M-Lazy-Developer / Report System Next",
  "namespace": "report-system-next",
  "designVersion": "1.6.0",
  "lifecycle": "DESIGN_LOCKED_REPORT_FIRST_EXPLAIN_TEST",
  "compatibility": {
    "reportSchema": "m-lazy-report-next/v1.6",
    "testerWorkspaceSchema": "m-lazy-tester-workspace-next/v1",
    "templateId": "m-lazy-report-next/html-v1.6",
    "sourceExistingApprovedBugReportV2": "NOT_A_MUTATION_TARGET",
    "legacyReportPaths": "UNTOUCHED"
  },
  "immutableWithinVersion": [
    "layout.sections",
    "layout.findingGroupOrder",
    "layout.findingCardCollapsed",
    "layout.findingCardExpanded",
    "layout.technicalDisclosure",
    "layout.summaryMetricOrder",
    "vocabulary",
    "tokens",
    "behavior",
    "output.fileNames",
    "output.canonicalization"
  ],
  "changePolicy": {
    "lockChange": "EXPLICIT_USER_APPROVAL_AND_DESIGN_VERSION_BUMP",
    "unapprovedChange": "REJECT_AND_KEEP_LAST_APPROVED_VERSION",
    "newConversation": "READ_THIS_LOCK_AND_DESIGN_BEFORE_REPORT_AUTHORING",
    "renderer": "ONE_DETERMINISTIC_RENDERER_ONLY",
    "noFreeformAiHtml": true,
    "snapshotAcceptance": "REQUIRED_BEFORE_RELEASE",
    "layoutDeviation": "FAIL_CLOSED"
  },
  "layout": {
    "sections": [
      "utilityHeader",
      "mapIdentity",
      "auditStatusAndSummary",
      "findingsWorkspace",
      "retestSummaryOnDemand",
      "reportFooter"
    ],
    "findingGroupOrder": [
      "BUG",
      "DESIGN_MISMATCH",
      "DEV_NOTE"
    ],
    "severityOrder": [
      "BLOCKER",
      "MAJOR",
      "MINOR"
    ],
    "findingCardCollapsed": [
      "referenceNumber",
      "issueType",
      "honestEvidenceStatus",
      "severityIfKnown",
      "title",
      "problemIfDistinct",
      "impactIfPresent",
      "canonicalFindingId"
    ],
    "findingCardExpanded": [
      "whatHappens",
      "whySourceSuggestsItHappens",
      "howToVerifyWithExplicitProvenance",
      "expectedVersusObserved",
      "technicalSourceOnDemand",
      "testerWorkspaceOnDemand"
    ],
    "technicalDisclosure": [
      "analysisIfPresent",
      "relatedSources",
      "recommendedFixIfPresent",
      "mustPreserve"
    ],
    "summaryMetricOrder": [
      "findings",
      "needsValidation",
      "sourceSupported"
    ],
    "testerMetricOrder": [
      "passed",
      "failed",
      "untested",
      "notRetestable"
    ],
    "searchFields": [
      "title",
      "findingId",
      "problem",
      "rationale",
      "impact",
      "expected",
      "observed",
      "validation"
    ],
    "filterFields": [
      "kind",
      "proofStatus",
      "severityAdvanced",
      "testerResultAdvanced"
    ],
    "defaultOpenState": "ALL_FINDING_CARDS_COLLAPSED",
    "responsiveBreakpointsPx": {
      "mobileMax": 700,
      "desktopReportMaxWidth": 1080
    },
    "desktopViewportTargetsPx": [
      {
        "width": 1366,
        "height": 768
      },
      {
        "width": 1920,
        "height": 1080
      }
    ],
    "mobileAcceptancePolicy": "PRESERVE_EXISTING_CSS_NOT_REQUIRED_FOR_RELEASE",
    "desktopReadOrder": [
      "selectedMapAndScope",
      "issueSummary",
      "issueDescription",
      "whyHappens",
      "howToVerify",
      "whatCountsAsEvidence",
      "sourceReferencesOnDemand",
      "optionalTesterNotes"
    ]
  },
  "vocabulary": {
    "reportTitle": "Map issue report",
    "sectionBugs": "Bugs",
    "sectionDesign": "Design mismatches",
    "sectionNotes": "Developer notes",
    "testProcedure": "Test In-Game",
    "expected": "Expected",
    "observed": "Observed / Evidence",
    "verifiedSource": "Source Verified",
    "packageVerified": "Package Verified",
    "runtimeObserved": "Runtime Observed",
    "needsValidation": "Needs Validation",
    "passed": "Passed",
    "failed": "Failed",
    "untested": "Untested",
    "notRetestable": "Not Retestable",
    "testerNotes": "Tester Notes",
    "technical": "Technical Details",
    "recommendedFix": "Recommended Fix",
    "preserve": "Must Preserve",
    "saveHtml": "Save as HTML",
    "saveJson": "Save Tester Data",
    "loadJson": "Load Tester Data",
    "reset": "Reset Tester Data",
    "savedBrowser": "Autosaved in browser",
    "fileStatus": "HTML download started; confirm file before sharing",
    "auditCoverage": "Audit Coverage",
    "coverageMissing": "Audit completeness not established by this report.",
    "validationDetail": "What Needs Validation",
    "sourceEvidence": "Source Evidence",
    "auditProven": "Audit Proven",
    "sourceReferenceUnresolved": "Source Reference Unresolved",
    "priorityUnset": "Priority Unset",
    "auditCues": "Source Audit Cues",
    "pendingChecks": "Unresolved Checks",
    "mapAuditTitle": "Map Audit Report",
    "sourceReviewTitle": "Source Review",
    "demoTitle": "Synthetic Report Demo",
    "downloadReportJson": "Download Report JSON",
    "unrelatedApprovedLedger": "Approved Bug Report V2 is a separate ledger; its issue count is not included here.",
    "auditStatus": "Audit status",
    "findingsHeading": "Findings",
    "whatNext": "Next action",
    "moreFilters": "Advanced filters",
    "testerDataTools": "More options",
    "sourceMetadata": "Source file & fingerprint",
    "technicalDetails": "Developer details",
    "reviewEvidence": "Source evidence",
    "reviewStatus": "Proof status",
    "reviewAction": "How to verify",
    "whatHappens": "What is the problem?",
    "howHappens": "Why might it happen?",
    "howToConfirm": "How to check it",
    "sourceCheckNotExecuted": "Source-derived verification steps · NOT executed or confirmed in Minecraft.",
    "sourceCheckMissing": "No reliable gameplay test sequence is recorded. Inspect the cited source and gather a reproducible in-game case.",
    "testMayConfirm": "A repeatable difference from Expected supports this finding; capture observed behavior and context.",
    "testDoesNotReproduce": "If the expected behavior occurs, record Not Reproduced. One attempt does not prove the issue is absent.",
    "sourceCauseNotEstablished": "The mechanism is not yet established. This is a hypothesis, not a confirmed cause.",
    "sourceClaimNotRuntime": "Source findings are not equivalent to an observed in-game failure.",
    "testerNotesOptional": "Record tester observations (optional)",
    "issueSummary": "Issue summary"
  },
  "tokens": {
    "font": "system-ui, -apple-system, Segoe UI, sans-serif",
    "codeFont": "ui-monospace, SFMono-Regular, Consolas, monospace",
    "colors": {
      "navy": "#172B4D",
      "blue": "#3157A4",
      "text": "#172033",
      "muted": "#667085",
      "border": "#D9DEE8",
      "background": "#F8FAFC",
      "success": "#28733B",
      "danger": "#A22929",
      "warning": "#8A5700"
    },
    "spacingPx": [
      4,
      8,
      12,
      16,
      24
    ],
    "reportWidthPx": 1200,
    "bodyTextPx": 14,
    "titleTextPx": 17
  },
  "behavior": {
    "generatedHtmlOfflineSingleFile": true,
    "scriptAndCssEmbedded": true,
    "noRemoteRuntimeDependency": true,
    "mainAction": "saveHtml",
    "autosave": "BROWSER_LOCAL_ONLY",
    "portableSave": "EXPLICIT_FILE_DOWNLOAD",
    "portableHtmlIncludes": [
      "fullCanonicalReport",
      "testerWorkspaceSnapshot",
      "screenshotData",
      "captions"
    ],
    "importPolicy": "EXACT_CANONICAL_DIGEST_MATCH",
    "uiNeverMutatesCanonicalFacts": true,
    "filtersNeverRemoveExportedFindings": true,
    "retestStateOnlyOnEvidenceEligibleFindings": true,
    "missingGameplaySteps": "SHOW_NOT_RETESTABLE_NOT_INVENT_STEPS",
    "devNotesNeverHaveSeverityOrTesterResult": true,
    "saveReportsDownloadStartedNotDiskVerified": true,
    "browserStorageFailure": "CONTINUE_IN_MEMORY_WARN_AND_OFFER_SAVE_HTML",
    "sameCopyRecovery": "SNAPSHOT_THEN_SAME_COPY_AUTOSAVE",
    "resetBehavior": "PERSIST_EXPLICIT_EMPTY_WORKSPACE_OVERRIDE",
    "unprovenNeverHasFinalSeverity": true,
    "validationProofMustBeShown": true,
    "auditCoverageMustBeSourceBacked": true,
    "proofIsNotRuntime": true,
    "auditSourceMustPreserveUnknowns": true,
    "browserRechecksCanonicalDigest": true,
    "evidenceTierIndependentOfProofStatus": true,
    "desktopFirstFindingsRemainReachable": true,
    "coverageGapsReadableOnDemand": true,
    "auditedUnknownsAlwaysVisible": true,
    "technicalEvidenceCollapsedByDefault": true,
    "findingsAboveFoldPriority": true,
    "testerInputsSeparateFromCanonical": true,
    "reportFirstProblemCauseVerification": true,
    "sourceReproductionCuesMustNeverEnablePassedFailed": true,
    "verifyStepsLabelActualProvenance": true,
    "notReproducedIsNotBugAbsent": true,
    "testerInputsOnDemand": true,
    "noInventedTestProcedure": true
  },
  "output": {
    "fileNames": {
      "canonical": "<slug>-v<artifact-version>-Report.json",
      "html": "<slug>-v<artifact-version>-Tester-Report.html",
      "workspace": "<slug>-v<artifact-version>-Tester-State.json",
      "combined": "Combined-Report"
    },
    "canonicalization": "RFC8785_JCS",
    "ordering": "GROUP_KIND_THEN_SEVERITY_THEN_STABLE_FINDING_ID",
    "unchangedInputInvariant": "IDENTICAL_CANONICAL_JSON_AND_GENERATED_HTML_BYTES",
    "nondeterminismForbiddenInGeneratedReport": [
      "currentTime",
      "randomId",
      "browserLocaleSort",
      "networkResponse",
      "aiParaphrase"
    ],
    "testerHtmlIsSnapshot": true,
    "downloadDoesNotOverwriteCanonicalReport": true
  },
  "acceptance": {
    "structural": [
      "JSON_SCHEMA",
      "CROSS_REFERENCE_IDS",
      "SOURCE_FINGERPRINT",
      "SCOPE_CARDINALITY",
      "EVIDENCE_CLAIM_COHERENCE"
    ],
    "rendering": [
      "GOLDEN_HTML_BYTE_SNAPSHOT",
      "DESKTOP_LAYOUT_1366x768",
      "DESKTOP_LAYOUT_1920x1080",
      "DESKTOP_KEYBOARD_FOCUS",
      "ACCESSIBILITY_REVIEW"
    ],
    "handoff": [
      "OPEN_OFFLINE",
      "EDIT",
      "AUTOSAVE_WARNING",
      "SAVE_AS_HTML",
      "REOPEN_ON_ANOTHER_BROWSER_CONTEXT",
      "PRESERVE_ATTACHMENTS",
      "NO_CANONICAL_MUTATION"
    ],
    "failClosedOn": [
      "UNKNOWN_SCHEMA",
      "UNKNOWN_TEMPLATE",
      "MISSING_EVIDENCE",
      "MISMATCHED_ARTIFACT",
      "STALE_HTML_JSON",
      "UNAPPROVED_LAYOUT_CHANGE"
    ]
  }
}
