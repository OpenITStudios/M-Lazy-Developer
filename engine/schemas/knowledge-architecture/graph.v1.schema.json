{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/knowledge-architecture/graph/v1",
  "title": "M-Bedrock-Dev Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "type",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "ROUTES_TO",
            "OWNS",
            "IMPLEMENTS",
            "USES",
            "DEPENDS_ON",
            "VALIDATES",
            "RELATES_TO",
            "DERIVED_FROM"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "const": "EXTRACTED"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "line",
            "target"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
