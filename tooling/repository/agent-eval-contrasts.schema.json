{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Lazy-Developer Agent Eval Harness Contrasts",
  "description": "Read-only optional sidecar for comparing existing agent eval run IDs; not a new result owner or Minecraft proof.",
  "type": "object",
  "required": [
    "schemaVersion",
    "policy",
    "runEvidence",
    "contrasts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "const": "agent-eval-harness-contrasts"
    },
    "runEvidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "runId",
          "inputFingerprint",
          "harnessFingerprint",
          "executionStatus",
          "executionEvidenceSha256",
          "receiptFile"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "harnessFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executionStatus": {
            "type": "string",
            "enum": [
              "executed",
              "source-reviewed",
              "not-executed"
            ]
          },
          "executionEvidenceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the actual receipt JSON bytes, not a placeholder."
          },
          "receiptFile": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}\\.json$",
            "description": "Direct child filename under an explicitly supplied receipts directory; no path traversal or symlinks."
          }
        },
        "additionalProperties": false
      }
    },
    "contrasts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "changedComponents",
          "pairs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "changedComponents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pairs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "baselineRunId",
                "candidateRunId"
              ],
              "properties": {
                "baselineRunId": {
                  "type": "string",
                  "minLength": 1
                },
                "candidateRunId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "proposedLesson": {
            "type": "object",
            "required": [
              "cue",
              "operation"
            ],
            "properties": {
              "cue": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
