{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Agent Eval Runs",
  "type": "object",
  "required": [
    "schemaVersion",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "runId"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "selectedLane": {
            "type": [
              "string",
              "null"
            ]
          },
          "selectedSkill": {
            "type": [
              "string",
              "null"
            ]
          },
          "selectedTaskClass": {
            "type": [
              "string",
              "null"
            ]
          },
          "assertions": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": "string"
          },
          "skillRevision": {
            "type": "string"
          },
          "selectedOperation": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "BENCHMARK",
              "APPROVED_TARGET_REPAIR",
              "identify-canonical-owner",
              null
            ],
            "description": "Suboperation within one of the two active skills, never an independently routable skill."
          },
          "selectedKnowledgeDomain": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "artifact-engineering",
              "content-analysis",
              "compatibility",
              "cross-owner-routing",
              null
            ],
            "description": "Non-agent knowledge reference, never a third work lane."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
