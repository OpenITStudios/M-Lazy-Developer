{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Lane Permission Request",
  "type": "object",
  "required": [
    "lane",
    "action"
  ],
  "properties": {
    "lane": {
      "enum": [
        "m-bedrock-system-improvement",
        "m-bedrock-map-testing"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "enum": [
        "engine",
        "target",
        "workspace",
        "network",
        "processExecution"
      ]
    },
    "mode": {
      "enum": [
        "read",
        "write"
      ]
    },
    "operation": {
      "enum": [
        "STANDARD",
        "BENCHMARK",
        "APPROVED_TARGET_REPAIR"
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "kind",
        "userMessageRef",
        "selectedArtifactSha256",
        "mustChange",
        "mustPreserve"
      ],
      "properties": {
        "kind": {
          "const": "EXPLICIT_USER_MESSAGE"
        },
        "userMessageRef": {
          "type": "string",
          "minLength": 1
        },
        "selectedArtifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mustChange": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "mustPreserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Two public lanes; BENCHMARK is an immutable Improve System operation; approved working-copy repair requires explicit human approval within Test Map."
}
