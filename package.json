{
  "name": "lazy-developer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft Bedrock and Minecraft Education content-engineering workspace",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "verify:repository": "node tooling/repository/verify.mjs && npm run verify:ownership && npm run verify:capability-truth && npm run verify:authority && npm run verify:naming && npm run verify:information-architecture && npm run verify:knowledge-architecture && npm run verify:remote-workflow-policy && npm run verify:documentation-paths && npm run verify:documentation-routing && npm run verify:documentation-ownership && npm run verify:bug-finding-coverage && npm run verify:skills && npm run verify:skill-evals && npm run verify:permissions && npm run verify:audit-entrypoint && npm run audit:skills && npm run verify:modules && npm run verify:dependencies && node tooling/repository/verify-boundaries.mjs && node tooling/repository/verify-contract-registry.mjs && node tooling/repository/verify-reliability-catalogs.mjs && node tooling/repository/verify-reliability-history.mjs && node tooling/repository/verify-knowledge-catalogs.mjs && npm run verify:knowledge-bindings && npm run verify:detection-corpus",
    "verify:boundaries": "node tooling/repository/verify-boundaries.mjs",
    "verify:source": "npm run typecheck && npm run bug-report-ui:build && npm run test:full",
    "verify:full": "npm run verify:repository && npm run verify:source",
    "typecheck": "tsc --noEmit",
    "test": "node tooling/repository/run-tests.mjs",
    "cli": "tsx apps/cli/src/main.ts",
    "verify:modules": "node tooling/repository/verify-module-shape.mjs",
    "verify:dependencies": "node tooling/repository/verify-dependency-graph.mjs",
    "audit:source": "node tooling/repository/audit-source-hygiene.mjs",
    "audit:api": "node tooling/repository/audit-public-api.mjs",
    "bug-report-ui:dev": "vite --config tooling/bug-report-ui/vite.config.mjs",
    "bug-report-ui:build": "vite build --config tooling/bug-report-ui/vite.config.mjs",
    "bug-report-ui:preview": "vite preview --config tooling/bug-report-ui/vite.config.mjs",
    "verify:ownership": "node tooling/repository/verify-engine-ownership.mjs",
    "verify:authority": "node tooling/repository/verify-authority-separation.mjs",
    "verify:naming": "node tooling/repository/verify-canonical-naming.mjs",
    "verify:skills": "node tooling/repository/verify-skill-lanes.mjs",
    "verify:skill-evals": "node tooling/repository/verify-skill-evals.mjs",
    "audit:skills": "node tooling/repository/skill-security-scan.mjs",
    "capability:truth": "tsx tooling/repository/generate-capability-truth.mjs",
    "verify:capability-truth": "node tooling/repository/verify-capability-truth.mjs",
    "generate:known-limits": "node tooling/repository/generate-known-limits.mjs",
    "verify:permissions": "node tooling/repository/verify-lane-permissions.mjs",
    "score:agent-eval": "node tooling/repository/score-agent-eval.mjs",
    "generate:proof-backlog": "node tooling/repository/generate-capability-proof-backlog.mjs",
    "bug-report-html": "tsx tooling/bug-report-documents/render.ts",
    "verify:audit-entrypoint": "node tooling/repository/verify-selected-map-audit-entrypoint.mjs",
    "verify:knowledge-bindings": "node tooling/repository/verify-knowledge-detector-bindings.mjs",
    "verify:information-architecture": "node tooling/repository/verify-information-architecture.mjs",
    "verify:bug-finding-coverage": "node tooling/repository/verify-bug-finding-coverage.mjs",
    "verify:documentation-ownership": "node tooling/repository/verify-documentation-ownership.mjs",
    "audit:knowledge-consumption": "node tooling/repository/audit-knowledge-consumption.mjs",
    "verify:knowledge-consumption": "node tooling/repository/audit-knowledge-consumption.mjs --strict",
    "verify:documentation-paths": "node tooling/repository/verify-documentation-paths.mjs",
    "verify:local-ready": "npm run verify:full && npm run audit:source && npm run audit:api",
    "verify:remote-workflow-policy": "node tooling/repository/verify-remote-workflow-policy.mjs",
    "verify:documentation-routing": "node tooling/repository/verify-documentation-routing.mjs",
    "verify:knowledge-architecture": "tsx tooling/repository/verify-knowledge-architecture.mjs",
    "retrieve:repository": "tsx tooling/repository/retrieve.ts",
    "verify:detection-corpus": "node .agents/skills/m-bedrock-detection-benchmark/scripts/validate-corpus.mjs",
    "status:detection-corpus": "node .agents/skills/m-bedrock-detection-benchmark/scripts/corpus-status.mjs",
    "score:detection-benchmark": "node .agents/skills/m-bedrock-detection-benchmark/scripts/score-benchmark.mjs",
    "aggregate:detection-benchmark": "node .agents/skills/m-bedrock-detection-benchmark/scripts/aggregate-runs.mjs",
    "freeze:detection-observation": "node .agents/skills/m-bedrock-detection-benchmark/scripts/freeze-observed-map-audit.mjs",
    "audit": "tsx apps/cli/src/audit.ts",
    "test:full": "node tooling/repository/run-tests.mjs --full",
    "test:focus": "node tooling/repository/run-tests.mjs --focus"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.17.0",
    "fast-check": "4.10.2",
    "prismarine-nbt": "^2.7.0",
    "svelte": "5.57.0",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.15.30",
    "tsx": "^4.20.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0"
  },
  "packageManager": "npm@10.9.2",
  "optionalDependencies": {
    "@8crafter/leveldb-zlib": "1.6.0"
  }
}
